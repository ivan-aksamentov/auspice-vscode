{
  "name": "auspice-vscode",
  "displayName": "Auspice VSCode",
  "version": "0.1.0",
  "description": "Explore local phylogenetic trees with Auspice in VS Code. Supports Auspice JSON & Newick.",
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "auspice",
    "newick",
    "nextstrain",
    "phylogenetics",
    "tree"
  ],
  "license": "MIT AND AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/ivan-aksamentov/auspice-vscode.git"
  },
  "publisher": "ivan-aksamentov",
  "files": [
    "dist",
    "assets/img/logo-256.png",
    "assets/img/logo-tab-32.png",
    "README.md",
    "LICENSE",
    "assets/licenses"
  ],
  "type": "module",
  "main": "./dist/extension.mjs",
  "scripts": {
    "build": "bun run typecheck && bun run scripts/build.ts",
    "build:extension": "bun build src/extension.ts --target=node --format=esm --external=vscode --outfile=dist/extension.mjs",
    "build:client": "bun run scripts/build-client.ts",
    "check": "bun run fmt:check && bun run lint && bun run typecheck",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "bun run scripts/test.ts",
    "test:unit": "bun test test/__tests__",
    "test:browser": "bun run scripts/test-browser.ts",
    "test:vscode": "bun run scripts/test-vscode.ts",
    "package": "bun run build && vsce package --no-dependencies --out auspice-vscode.vsix",
    "release": "bun run scripts/release.ts"
  },
  "dependencies": {
    "auspice": "2.73.0",
    "i18next": "19.9.2",
    "phylotree": "2.6.0",
    "react": "16.14.0",
    "react-dom": "16.14.0",
    "react-i18next": "11.18.6",
    "react-redux": "7.2.9",
    "styled-components": "4.4.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.29.7",
    "@babel/preset-react": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@playwright/test": "1.61.1",
    "@types/babel__core": "7.20.5",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@types/react": "16.14.70",
    "@types/react-dom": "16.9.25",
    "@types/vscode": "1.67.0",
    "@vscode/test-electron": "3.0.0",
    "@vscode/vsce": "3.9.1",
    "fast-check": "4.9.0",
    "oxfmt": "0.54.0",
    "oxlint": "1.68.0",
    "oxlint-tsgolint": "0.23.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "d3-color": "3.1.0",
    "dompurify": "3.4.12"
  },
  "contributes": {
    "commands": [
      {
        "command": "auspiceVscode.open",
        "title": "Open in Auspice",
        "category": "Auspice",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "auspiceVscode.toggle",
        "title": "Toggle Auspice",
        "category": "Auspice",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "auspiceVscode.reload",
        "title": "Reload Auspice View",
        "category": "Auspice",
        "icon": "$(refresh)"
      },
      {
        "command": "auspiceVscode.showDiagnostics",
        "title": "Show Input Diagnostics",
        "category": "Auspice",
        "icon": "$(issues)"
      },
      {
        "command": "auspiceVscode.openInTaxonium",
        "title": "Open Current Tree in Taxonium",
        "category": "Auspice",
        "icon": "$(link-external)"
      },
      {
        "command": "auspiceVscode.compareWithTree",
        "title": "Compare with Another Tree",
        "category": "Auspice",
        "icon": "$(git-compare)"
      },
      {
        "command": "auspiceVscode.addMetadata",
        "title": "Add Metadata to Current View",
        "category": "Auspice",
        "icon": "$(table)"
      },
      {
        "command": "auspiceVscode.showInputs",
        "title": "Show Attached Input Files",
        "category": "Auspice",
        "icon": "$(files)"
      },
      {
        "command": "auspiceVscode.openNarrative",
        "title": "Open Local Narrative",
        "category": "Auspice",
        "icon": "$(book)"
      }
    ],
    "customEditors": [
      {
        "viewType": "auspiceVscode.viewer",
        "displayName": "Auspice VSCode",
        "selector": [
          {
            "filenamePattern": "*.auspice.json"
          },
          {
            "filenamePattern": "*.auspicejson"
          },
          {
            "filenamePattern": "*.auspice.json.gz"
          },
          {
            "filenamePattern": "*.auspicejson.gz"
          },
          {
            "filenamePattern": "*.new"
          },
          {
            "filenamePattern": "*.nwk"
          },
          {
            "filenamePattern": "*.newick"
          },
          {
            "filenamePattern": "*.new.gz"
          },
          {
            "filenamePattern": "*.nwk.gz"
          },
          {
            "filenamePattern": "*.newick.gz"
          }
        ],
        "priority": "option"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "auspiceVscode.toggle",
          "when": "resourceFilename =~ /(\\.(auspice\\.json|auspicejson|newick|nwk|new)|_meta\\.json|_tree\\.json)(\\.gz)?$/i || activeCustomEditorId == auspiceVscode.viewer",
          "group": "navigation@1"
        },
        {
          "command": "auspiceVscode.showDiagnostics",
          "when": "activeCustomEditorId == auspiceVscode.viewer"
        }
      ],
      "explorer/context": [
        {
          "command": "auspiceVscode.open",
          "when": "resourceFilename =~ /(\\.(auspice\\.json|auspicejson|newick|nwk|new)|_meta\\.json|_tree\\.json)(\\.gz)?$/i",
          "group": "navigation@20"
        }
      ],
      "commandPalette": [
        {
          "command": "auspiceVscode.reload",
          "when": "auspiceVscode.viewerActive"
        },
        {
          "command": "auspiceVscode.showDiagnostics",
          "when": "auspiceVscode.viewerActive"
        },
        {
          "command": "auspiceVscode.openInTaxonium",
          "when": "auspiceVscode.viewerActive"
        },
        {
          "command": "auspiceVscode.compareWithTree",
          "when": "auspiceVscode.viewerActive"
        },
        {
          "command": "auspiceVscode.addMetadata",
          "when": "auspiceVscode.viewerActive"
        },
        {
          "command": "auspiceVscode.showInputs",
          "when": "auspiceVscode.viewerActive"
        },
        {
          "command": "auspiceVscode.openNarrative"
        }
      ]
    },
    "configuration": {
      "title": "Auspice VSCode",
      "properties": {
        "auspiceVscode.resourceLimitMiB": {
          "type": "integer",
          "default": 256,
          "minimum": 1,
          "maximum": 1024,
          "scope": "resource",
          "description": "Maximum size of each input and of the combined expanded session data."
        },
        "auspiceVscode.staleFileBehavior": {
          "type": "string",
          "enum": [
            "ask",
            "reload",
            "keep"
          ],
          "default": "reload",
          "scope": "resource",
          "enumDescriptions": [
            "Ask before replacing the current view when an input changes.",
            "Reload changed inputs automatically.",
            "Keep the current view and show a stale-data indicator."
          ],
          "description": "How open viewers respond when an input changes on disk."
        },
        "auspiceVscode.companionDiscovery": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Automatically attach exact sibling sidecars and legacy v1 tree/meta pairs to the primary dataset."
        },
        "auspiceVscode.sidebarInitialState": {
          "type": "string",
          "enum": [
            "open",
            "closed",
            "dataset"
          ],
          "default": "open",
          "scope": "resource",
          "enumDescriptions": [
            "Open the Auspice controls when a viewer starts.",
            "Start with the controls folded.",
            "Use the dataset's declared sidebar default."
          ],
          "description": "Initial sidebar state for newly opened or reloaded Auspice tabs."
        },
        "auspiceVscode.preserveBackgroundViews": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "description": "Preserve each Auspice webview and its interactive state while its tab is hidden. Changing this setting requires Reload Window."
        },
        "auspiceVscode.mapsEnabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Show maps and allow their background tiles to load from external providers. Dataset files always remain local. Applies when an Auspice tab is reopened or reloaded."
        },
        "auspiceVscode.largeTreeTipAdvisory": {
          "type": "integer",
          "default": 5000,
          "minimum": 0,
          "scope": "resource",
          "description": "Show a performance advisory above this number of tips. Set to 0 to disable."
        },
        "auspiceVscode.zoom": {
          "type": [
            "string",
            "number"
          ],
          "default": "auto",
          "scope": "resource",
          "markdownDescription": "Render scale of the viewer. VS Code magnifies webview content along with the editor zoom (`#window.zoomLevel#`), which enlarges the phylogeny and can force a mobile layout. `auto` cancels the editor zoom so the viewer renders at 100%. A positive number pins an explicit scale (`1` follows the editor zoom, `0.8` renders at 80%)."
        }
      }
    }
  },
  "icon": "assets/img/logo-256.png",
  "galleryBanner": {
    "color": "#21252b",
    "theme": "dark"
  },
  "engines": {
    "node": ">=24.0.0",
    "vscode": "^1.74.0"
  },
  "packageManager": "bun@1.3.14",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "patchedDependencies": {
    "auspice@2.73.0": "patches/auspice@2.73.0.patch"
  }
}
