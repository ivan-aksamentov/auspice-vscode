+  const labelBox = {left: 0, top: 0, right: width, bottom: height};
+  treeGroup.querySelectorAll("text").forEach((label, i) => {
+    const style = window.getComputedStyle(label);
+    const rect = label.getBoundingClientRect();
+    if (!label.textContent.trim() || !rect.width || style.visibility === "hidden") return;
+    const left = rect.left - origin.left;
+    const right = rect.right - origin.left;
+    const top = rect.top - origin.top;
+    const bottom = rect.bottom - origin.top;
+    const anchor = labelAnchorX(left, right, style.textAnchor);
