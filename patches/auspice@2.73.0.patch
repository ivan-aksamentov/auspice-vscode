+const processTreePanel = (treeGroup) => {
+  const origin = treeGroup.ownerSVGElement.getBoundingClientRect();
+  const width = parseFloat(treeGroup.getAttribute("width"));
+  const height = parseFloat(treeGroup.getAttribute("height"));
